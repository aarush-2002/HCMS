# ==========================================
# HMCS API Environment Variables Example
# ==========================================

NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/hmcs_db?schema=public"
JWT_SECRET="super-secret-jwt-key-replace-in-production-hmcs-2026"
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"
COOKIE_DOMAIN=""
UPLOAD_DIR="./uploads"

# Rate Limiting
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_GLOBAL_MAX=500
