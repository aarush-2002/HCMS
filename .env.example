# ==========================================
# HMCS (Hostel Management Complaint System)
# Root Environment Configuration Example
# ==========================================

# Environment Mode: development | test | production
NODE_ENV=development

# API Service
PORT=4000
API_PORT=5000
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/hmcs_db?schema=public"
JWT_SECRET="super-secret-jwt-key-replace-in-production-hmcs-2026"
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"
UPLOAD_DIR="./uploads"

# Database Configuration (for Docker Compose)
POSTGRES_USER=hmcs
POSTGRES_PASSWORD=hmcs_secret
POSTGRES_DB=hmcs_db
POSTGRES_PORT=5432

# Frontend Service
VITE_API_BASE_URL="http://localhost:4000"
WEB_PORT=3000
